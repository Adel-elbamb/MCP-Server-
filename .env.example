NODE_ENV=development
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=info

# reports-businesschat base URL, including the /api/v1 global prefix
REPORTS_BASE_URL=http://localhost:3006/api/v1
REPORTS_TIMEOUT_MS=15000

# Local testing only. Used when the MCP request has no Authorization / x-workspace-id header.
# REPORTS_TOKEN may be a raw JWT or "Bearer <jwt>".
REPORTS_TOKEN=
REPORTS_WORKSPACE_ID=
